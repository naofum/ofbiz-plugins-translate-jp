<ofbiz-component name="translate-jp" enabled="true"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/ofbiz-component.xsd">

    <!-- リソースローダー -->
    <resource-loader name="main" type="component"/>

    <!-- config/ をクラスパスに追加（UiLabels 読み込み用） -->
    <classpath type="dir" location="config"/>

    <!-- サービス定義 -->
    <service-resource type="model" loader="main" location="servicedef/services.xml"/>

    <!-- 管理者のみアクセス可能（OFBTOOLS 権限必須）、アプリバー非表示 -->
    <webapp name="translate-jp"
        title="JP Translation"
        position="99"
        server="default-server"
        location="webapp/translate-jp"
        base-permission="OFBTOOLS"
        mount-point="/translate-jp"
        app-bar-display="true"/>

</ofbiz-component>

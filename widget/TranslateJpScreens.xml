<screens xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Widget-Screen"
        xsi:schemaLocation="http://ofbiz.apache.org/Widget-Screen http://ofbiz.apache.org/dtds/widget-screen.xsd">

    <!--
        メイン画面: 日本語翻訳適用フォーム
        URL: /translate-jp/control/main
    -->
    <screen name="main">
        <section>
            <actions>
                <set field="titleProperty" value="TranslateJpPageTitle"/>

                <!-- uilabel/ フォルダー下の XML ファイル数を取得 -->
                <script location="component://translate-jp/src/main/groovy/org/apache/ofbiz/translatejp/CountUiLabelFiles.groovy"/>

                <!-- サービス実行結果は requestAttributes._EVENT_MESSAGE_ / _ERROR_MESSAGE_ で参照 -->
            </actions>
            <widgets>
                <decorator-screen name="main-decorator"
                                  location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <section>
                            <condition>
                                <if-has-permission permission="OFBTOOLS" action="_VIEW"/>
                            </condition>
                            <widgets>

                                <!-- ページタイトル -->
                                <container style="h1">
                                    <label>${uiLabelMap.TranslateJpPageTitle}</label>
                                </container>

                                <!-- 成功メッセージ (_EVENT_MESSAGE_ = successMessage OUT パラメータ) -->
                                <section>
                                    <condition>
                                        <not><if-empty field="requestAttributes._EVENT_MESSAGE_"/></not>
                                    </condition>
                                    <widgets>
                                        <container style="successMessage">
                                            <label>${requestAttributes._EVENT_MESSAGE_}</label>
                                        </container>
                                    </widgets>
                                </section>

                                <!-- 翻訳適用時のみ: バックアップ先と再起動案内（fileCount がある場合） -->
                                <section>
                                    <condition>
                                        <not><if-empty field="requestAttributes.fileCount"/></not>
                                    </condition>
                                    <widgets>
                                        <container style="successMessage">
                                            <label>${uiLabelMap.TranslateJpBackupCreated}${requestAttributes.backupPath}</label>
                                        </container>
                                        <container style="message">
                                            <label style="warning">${uiLabelMap.TranslateJpRestartNotice}</label>
                                        </container>
                                    </widgets>
                                </section>

                                <!-- 地方公共団体コード インポート結果（geoImportSummary がある場合） -->
                                <section>
                                    <condition>
                                        <not><if-empty field="requestAttributes.geoImportSummary"/></not>
                                    </condition>
                                    <widgets>
                                        <container style="message">
                                            <label>${requestAttributes.geoImportSummary}</label>
                                        </container>
                                        <container style="message">
                                            <label style="warning">${uiLabelMap.TranslateJpGeoImportAttribution}</label>
                                        </container>
                                    </widgets>
                                </section>

                                <!-- エラーメッセージ (_ERROR_MESSAGE_) -->
                                <section>
                                    <condition>
                                        <not><if-empty field="requestAttributes._ERROR_MESSAGE_"/></not>
                                    </condition>
                                    <widgets>
                                        <container style="errorMessage">
                                            <label>${uiLabelMap.TranslateJpErrorMessage}${requestAttributes._ERROR_MESSAGE_}</label>
                                        </container>
                                    </widgets>
                                </section>

                                <!-- 更新フォーム -->
                                <platform-specific>
                                    <html>
                                        <html-template location="component://translate-jp/webapp/translate-jp/applyForm.ftl"/>
                                    </html>
                                </platform-specific>

                            </widgets>
                            <fail-widgets>
                                <label style="h3">${uiLabelMap.TranslateJpViewPermissionError}</label>
                            </fail-widgets>
                        </section>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

</screens>

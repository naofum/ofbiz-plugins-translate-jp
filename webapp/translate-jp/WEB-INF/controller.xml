<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Site-Conf"
        xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf http://ofbiz.apache.org/dtds/site-conf.xsd">

    <include location="component://common/webcommon/WEB-INF/common-controller.xml"/>

    <description>JP Translation Plugin Site Configuration</description>

    <!-- メイン画面: UIラベル更新フォームを表示 -->
    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="main"/>
    </request-map>

    <!-- 更新実行: applyTranslationJp サービスを呼び出し、結果をメイン画面に表示 -->
    <request-map uri="applyTranslationJp">
        <security https="true" auth="true"/>
        <event type="service" invoke="applyTranslationJp"/>
        <response name="success" type="view"  value="main"/>
        <response name="error"   type="view"  value="main"/>
    </request-map>

    <!-- 地方公共団体コードのインポート: ダウンロードしてGeoデータを登録/更新 -->
    <request-map uri="importMunicipalityCode">
        <security https="true" auth="true"/>
        <event type="service" invoke="translateJpImportMunicipalityCode"/>
        <response name="success" type="view"  value="main"/>
        <response name="error"   type="view"  value="main"/>
    </request-map>

    <!-- ビューマッピング -->
    <view-map name="main" type="screen"
              page="component://translate-jp/widget/TranslateJpScreens.xml#main"/>

</site-conf>
